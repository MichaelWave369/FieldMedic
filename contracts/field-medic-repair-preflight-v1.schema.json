{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldmedic.local/schema/field-medic-repair-preflight-v1.schema.json",
  "title": "Field Medic Repair Preflight v1",
  "type": "object",
  "required": [
    "schema", "preflight_id", "proposal_id", "proposal_sha256",
    "case_id", "action_key", "state_before", "state_before_sha256",
    "expected_applied_state", "expected_applied_state_sha256",
