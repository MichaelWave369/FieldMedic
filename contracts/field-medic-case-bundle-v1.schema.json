{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldmedic.local/schema/field-medic-case-bundle-v1.schema.json",
  "title": "Field Medic Case Bundle v1",
  "type": "object",
  "required": ["schema", "case_id", "exported_at", "files", "manifest_sha256"],
  "properties": {
    "schema": {"const": "field-medic-case-bundle-v1"},
    "case_id": {"type": "string"},
    "exported_at": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
