{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldmedic.local/schema/field-medic-repair-execution-v1.schema.json",
  "title": "Field Medic Repair Execution v1",
  "type": "object",
  "required": [
    "schema", "case_id", "proposal", "proposal_sha256",
    "preflight", "grant", "action_key", "params",
