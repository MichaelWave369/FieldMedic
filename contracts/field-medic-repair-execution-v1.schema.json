    "expected_applied_state_sha256", "state_after_apply",
    "state_after_apply_sha256", "baseline_verification",
    "postaction_verification", "rollback", "status", "error",
    "outcome_claim", "causal_claim", "generic_shell_used",
    "execution_evidence_id"
  ],
  "properties": {
    "schema": {"const": "field-medic-repair-execution-v1"},
    "outcome_claim": {"const": "UNCLASSIFIED"},
    "causal_claim": {"const": false},
    "generic_shell_used": {"const": false}
  },
