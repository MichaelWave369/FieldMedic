{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldmedic.local/schema/field-medic-synthesis-v1.schema.json",
  "title": "Field Medic Synthesis Receipt v1",
  "type": "object",
  "required": [
    "schema", "case_id", "symptom", "domain", "summary", "claims",
    "specialist_ids", "reasoning", "uncertainties", "causal_claim", "authority_ceiling"
  ],
  "properties": {
    "schema": {"const": "field-medic-synthesis-v1"},
    "case_id": {"type": "string"},
    "symptom": {"type": "string"},
    "domain": {"type": "string"},
    "summary": {"type": "string"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "text", "evidence_ids", "causal_claim"],
        "properties": {
          "kind": {"type": "string"},
          "text": {"type": "string"},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "causal_claim": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "specialist_ids": {"type": "array", "items": {"type": "string"}},
    "reasoning": {"type": "object"},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "causal_claim": {"const": false},
    "authority_ceiling": {"const": "infer"}
  },
  "additionalProperties": false
}
